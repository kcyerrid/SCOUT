  "shift_log_rules": {
    "enabled": true,
    "entities": {
      "incident": {
        "enabled": true,
        "date_field": "created",
        "header_template": "### {time} \u2014 {incident_id} - {title}",
        "body_template": "Context:\n\n- What triggered this work?\n- Why did you look into it?\n\nActions:\n\n- What did you do?\n- Queries executed?\n- Tools used?\n\nFindings:\n\n- What did you learn?\n- Any anomalies or notable patterns?\n\nLinks:\n- [Alert link]\n- [Incident link]\n- [Investigation link]\n- [Observation link]"
      },
      "meeting": {
        "enabled": true,
        "date_field": "start_time",
        "header_template": "### {created_time} - New Meeting Created - {title} - {start_date} {start_time}",
        "body_template": "Purpose\n\n- What is the stated objective of the meeting?\n- What is your role in the meeting?\n\nAgenda\n\nPost-Meeting Reflection\n\n- Was this meeting worth my time?\n- What is the impact of this meeting to your personal processes or tools?\n\n---"
      },
      "playbook": {
        "enabled": true,
        "date_field": "created",
        "header_template": "### {time} - New Playbook Created - {playbook_id} - {title}",
        "body_template": ""
      },
      "procedure": {
        "enabled": true,
        "date_field": "created",
        "header_template": "### {time} - New Procedure Created - {procedure_id} - {title}",
        "body_template": ""
      },
      "project": {
        "enabled": true,
        "date_field": "created",
        "header_template": "### {time} - New Project Created - {project_id} - {title}",
        "body_template": "What is the role you are being asked to play in the project?  \n\nDo you agree with the objectives and reasoning behind the project?\n\nWhat are the critical next steps for you to get the project off on the right foot?\n\n---"
      },
      "itid": {
        "enabled": true,
        "date_field": "created",
        "header_template": "### {time} - New ITID Created - {itid_id} - {title}",
        "body_template": ""
      },
      "faq": {
        "enabled": true,
        "date_field": "created",
        "header_template": "### {time} - New FAQ Created - {faq_id} - {title}",
        "body_template": ""
      },
      "how_to": {
        "enabled": true,
