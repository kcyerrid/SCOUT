    "tag_rules": {
      "ransomware": [
        "ransomware",
        "extortion",
        "double extortion",
        "encryptor"
      ],
      "exploitation": [
        "actively exploited",
        "in the wild",
        "active exploitation",
        "zero-day",
        "0-day",
        "poc released"
      ],
      "phishing": [
        "phishing",
        "credential theft",
        "business email compromise",
        "bec"
      ],
      "vulnerability": [
        "cve-",
        "remote code execution",
        "rce",
        "privilege escalation",
        "auth bypass"
      ]
